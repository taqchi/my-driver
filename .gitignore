# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log

# Terraform plan files
*.tfplan

# Sensitive variable files (e.g., with secrets or credentials)
*.tfvars
*.tfvars.json

# Override files (often used for local configuration)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Lock file (optional: keep it if you want reproducible runs)
.terraform.lock.hcl

# IDE / Editor folders
.vscode/
.idea/
.DS_Store
